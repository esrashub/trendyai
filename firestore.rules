rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /brandIdentities/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /weeklyPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /connectedPlatforms/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /platforms/{platformId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // n8n "Start Weekly Flow" {userId}_{weekId}_{idx} formatında ID üretir.
    // userId field eksik olsa bile doc ID pattern eşleşiyorsa erişime izin ver.
    match /contentIdeas/{ideaId} {
      allow read: if request.auth != null && (
        resource == null
        || resource.data.userId == request.auth.uid
        || ideaId.matches('^' + request.auth.uid + '_.*')
      );
      allow write: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || ideaId.matches('^' + request.auth.uid + '_.*')
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid
        || ideaId.matches('^' + request.auth.uid + '_.*')
      );
    }

    // weeklyPlans/{userId_weekId}
    match /weeklyPlans/{weeklyPlanId} {
      allow read: if request.auth != null && (
        resource == null
        || resource.data.userId == request.auth.uid
        || weeklyPlanId.matches('^' + request.auth.uid + '_.*')
      );
      allow write: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || weeklyPlanId.matches('^' + request.auth.uid + '_.*')
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid
        || weeklyPlanId.matches('^' + request.auth.uid + '_.*')
      );
    }

    // generatedContents/content_{userId}_{weekId}_{idx}
    // n8n "Generate Content Text" yazar; Frontend onSnapshot ile dinler.
    match /generatedContents/{contentId} {
      allow read: if request.auth != null && (
        resource == null
        || resource.data.userId == request.auth.uid
        || contentId.matches('^content_' + request.auth.uid + '_.*')
      );
      allow write: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || contentId.matches('^content_' + request.auth.uid + '_.*')
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid
        || contentId.matches('^content_' + request.auth.uid + '_.*')
      );
    }

    // generatedVisuals/visual_{contentId}_{timestamp}
    // contentId zaten userId içeriyor → pattern kontrolü çalışır
    match /generatedVisuals/{visualId} {
      allow read: if request.auth != null && (
        resource == null
        || resource.data.userId == request.auth.uid
        || visualId.matches('^visual_content_' + request.auth.uid + '_.*')
      );
      allow write: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || visualId.matches('^visual_content_' + request.auth.uid + '_.*')
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid
        || visualId.matches('^visual_content_' + request.auth.uid + '_.*')
      );
    }

    // scheduledPosts — userId field zorunlu (post ID rastgele)
    match /scheduledPosts/{postId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /calendarEvents/{eventId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // n8n tarafından yazılır, tüm giriş yapmış kullanıcılar okuyabilir
    match /trendPools/{document} {
      allow read: if request.auth != null;
    }

    match /currentTrendPool/{document} {
      allow read: if request.auth != null;
    }

    // n8n workflow'ları hata loglarını buraya yazar (sadece okuma — yazımı service account yapar)
    match /errorLogs/{logId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }

    // n8n Generate Visual workflow log koleksiyonu
    match /visualGenerationLogs/{logId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }

  }
}
